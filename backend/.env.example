# Conexión a la base. Para desarrollo local se puede usar SQLite:
# DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT (mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# true solo si el backend se sirve por HTTPS
COOKIE_SECURE=false
